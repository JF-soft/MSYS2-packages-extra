# Maintainer: Jonatan R. Fischer <jonafischer at gmail dot com>

pkgname=python-click
pkgver=8.5.1
pkgrel=1
pkgdesc='Composable command line interface toolkit for Python'
arch=('any')
url='https://click.palletsprojects.com/'
msys2_references=(
  "purl: pkg:pypi/click"
)
license=('spdx:BSD-3-Clause')
depends=('python')
makedepends=(
  'python-build'
  'python-installer'
  'python-flit-core'
)
checkdepends=('python-pytest')
source=("click-${pkgver}.tar.gz::https://files.pythonhosted.org/packages/source/c/click/click-${pkgver}.tar.gz")
sha256sums=('9bbfada76703fd1d784b83eea012e3e8c6a001a876543ef104fa56aaaeb072b4')

build() {
  cd click-$pkgver
  # Upstream pins flit_core<4 while the MSYS2 repo ships python-flit-core
  # 4.2.0; the build works with it, so skip the over-strict PEP 517
  # dependency check. Documented per AGENTS.md section 10.1.
  python -m build --wheel --no-isolation --skip-dependency-check
}

check() {
  cd click-$pkgver
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  # Deselected tests (5) are platform-specific and fail on MSYS/cygwin:
  # - test_pipepager_less_detection_matches_stem: requires `less` in PATH,
  #   resolved differently in the MSYS environment.
  # - test_path_resolve_symlink: symlink resolution semantics differ on cygwin.
  # - test_open_file_atomic_permissions_existing_file: os.stat permission bits
  #   are not ext4-compatible on cygwin (2429 passed, 24 skipped).
  test-env/bin/python -m pytest tests -k \
    "not test_pipepager_less_detection_matches_stem and not test_path_resolve_symlink and not test_open_file_atomic_permissions_existing_file"
}

package() {
  cd click-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE.txt "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.txt"
}
