# Maintainer: Jonatan R. Fischer <jonafischer at gmail dot com>

pkgname=python-ujson
_name=ujson
pkgver=6.1.0
pkgrel=1
pkgdesc="Ultra fast JSON encoder and decoder for Python"
arch=('x86_64') # C extension
url="https://github.com/ultrajson/ultrajson"
msys2_references=(
  "purl: pkg:pypi/ujson"
)
license=('spdx:BSD-3-Clause AND TCL')
depends=('python')
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-setuptools-scm'
)
checkdepends=('python-pytest')
source=("${_name}-${pkgver}.tar.gz::https://files.pythonhosted.org/packages/source/${_name::1}/${_name}/${_name}-${pkgver}.tar.gz")
sha256sums=('aef7ea4cd9e2e9f8a35c4538a9780d58c80d76c5da66a8dad269b4cc6d930c29')

export SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver

build() {
  cd ${_name}-${pkgver}
  python -m build --wheel --no-isolation
}

check() {
  cd ${_name}-${pkgver}
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest tests
}

package() {
  cd ${_name}-${pkgver}
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE.txt -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
