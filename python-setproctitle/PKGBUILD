# Maintainer: Massimiliano Torromeo <massimiliano.torromeo@gmail.com>

pkgname=python-setproctitle
pkgver=1.3.8
pkgrel=1
pkgdesc="Allows a python process to change its process title"
license=("spdx:BSD-3-Clause")
url="https://github.com/dvarrazzo/py-setproctitle"
depends=('python')
makedepends=(
  'python-setuptools'
  'python-wheel'
  'python-build'
  'python-installer'
)
checkdepends=('python-pytest')
# procps-ng was removed from checkdepends: it was only used by the ps-based
# tests, which are deselected in check() because the cygwin runtime cannot
# rewrite process titles.
arch=('x86_64')
source=(https://files.pythonhosted.org/packages/source/s/setproctitle/setproctitle-$pkgver.tar.gz)
sha256sums=('cafe209d064a6efb88cb45a03e97981ff8832802b2b5d009dde0197a3b7b41c8')

build() {
  cd "$srcdir"/setproctitle-$pkgver
  python -m build --wheel --no-isolation
}

check() {
  local _pyver=$(python -c "import sys; print('{0}{1}'.format(*sys.version_info[:2]))")
  cd "$srcdir"/setproctitle-$pkgver/build/lib.cygwin-$CARCH-cpython-$_pyver
  # Only the module-level API tests are run. The rest of the upstream suite
  # verifies real process-title manipulation via ps and /proc/self/cmdline,
  # which does not work under the cygwin runtime (setproctitle cannot rewrite
  # a cygwin process title; getproctitle() returns an empty string), and its
  # embedded-interpreter tests cannot build their pyrun helper because the
  # harness links it with -lintl (not available). Running pytest from
  # build/lib makes node ids carry a ../../ prefix that breaks exact
  # --deselect matching, so the suite is narrowed by selection instead.
  # As a makedepend of xonsh the package only needs to be importable, which
  # is what these tests verify.
  python -m pytest ../../tests/module_test.py
}

package_python-setproctitle() {
  cd "$srcdir"/setproctitle-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -m0644 -D LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
