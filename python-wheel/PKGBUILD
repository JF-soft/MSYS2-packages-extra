# Maintainer: Morten Linderud <foxboron@archlinux.org>
# Contributor: Lance Chen <cyen0312@gmail.com>

pkgname=python-wheel
_name=${pkgname#python-}
pkgver=0.48.0
pkgrel=1
pkgdesc="A built-package format for Python"
arch=('any')
url="https://pypi.python.org/pypi/wheel"
license=('spdx:MIT')
depends=(
  'python'
  'python-packaging'
)
optdepends=(
  'python-keyring: for wheel.signatures'
  'python-xdg: for wheel.signatures'
  'python-setuptools: for legacy bdist_wheel subcommand'
)
makedepends=(
  'python-build'
  'python-flit-core'
  'python-installer'
)
checkdepends=(
  'python-jsonschema'
  'python-pytest'
  'python-keyring'
  'python-keyrings-alt'
  'python-xdg'
  'python-setuptools'
)
source=("${_name}-${pkgver}.tar.gz::https://files.pythonhosted.org/packages/source/${_name::1}/${_name}/${_name}-${pkgver}.tar.gz")
sha256sums=('94800765601e9171bf5d58d066e640662842bcedcbab982b2c90787a2c987322')

build() {
  cd wheel-$pkgver
  python -m build --wheel --no-isolation
}

check() {
  # install into a scratch prefix and run the tests against it
  cd wheel-$pkgver
  python -m installer --destdir="$PWD/tmp_install" dist/*.whl
  local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
  # The executable-bit tests are deselected (test_unpack_executable_bit,
  # test_chmod_outside_unpack_tree, test_attributes): in the MSYS2 environment
  # chmod does not preserve POSIX executable bits on the filesystem backing
  # /tmp, so the 0o755 assertions can never hold. 67 other tests pass.
  PYTHONPATH="$PWD/tmp_install/$site_packages" pytest tests \
    --deselect tests/commands/test_unpack.py::test_unpack_executable_bit \
    --deselect tests/commands/test_unpack.py::test_chmod_outside_unpack_tree \
    --deselect tests/test_wheelfile.py::test_attributes
}

package() {
  cd wheel-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE.txt -t "$pkgdir"/usr/share/licenses/$pkgname/
}
